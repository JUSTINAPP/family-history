# Save real values only in ignored .env.local. Never add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative: NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Explicit, fictional local visual preview only. Real mode is the default.
# ARCHIVE_DEMO_MODE=true

# Optional server-only document processing. Uploads never start AI automatically.
# Configure exactly one provider and an explicitly selected vision/Structured Outputs model.
DOCUMENT_AI_PROVIDER=
DOCUMENT_AI_MODEL=
OPENAI_API_KEY=
# Reserved for a future adapter; not required by the OpenAI adapter.
ANTHROPIC_API_KEY=
